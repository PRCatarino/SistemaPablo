# -----------------------------------------------------------------------------
# Supabase Postgres — duas URIs (ver prisma/schema.prisma)
#
# DATABASE_URL — pooler PgBouncer, porta 6543 (Vercel e npm run dev).
#   postgresql://postgres.SEU_REF:SENHA_ENCODED@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1
#
# DIRECT_URL — usado por prisma migrate deploy. Ideal: conexão direta :5432.
#   postgresql://postgres:SENHA_ENCODED@db.SEU_REF.supabase.co:5432/postgres?sslmode=require
# Se der P1001 na tua rede (porta 5432 bloqueada), usa a MESMA URI do pooler que DATABASE_URL (6543).
# O migrate no pooler pode ficar parado sem erro: nesse caso usa o workflow GitHub Actions
# (.github/workflows/prisma-migrate.yml) com secrets DIRECT_URL (direto :5432) e DATABASE_URL.
#
# Senha com @ ? + # ^ { } etc.: codifique com encodeURIComponent e coloque nas duas URIs,
# ou use POSTGRES_PASSWORD (crua) — o Next.js re-codifica em runtime (src/lib/database-url.ts).
# O Prisma CLI (migrate) lê DATABASE_URL/DIRECT_URL direto: a senha na string precisa estar %XX.
#
# Vercel: defina DATABASE_URL e DIRECT_URL nas Environment Variables.
#
# Storage (anexos): rode supabase/storage-card-attachments.sql no SQL Editor.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL="https://SEU_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole_a_chave_aqui"

SUPABASE_SERVICE_ROLE_KEY="cole_service_role_ou_sb_secret_aqui"

DATABASE_URL="postgresql://postgres.SEU_REF:SENHA_ENCODED@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres:SENHA_ENCODED@db.SEU_REF.supabase.co:5432/postgres?sslmode=require"

# POSTGRES_PASSWORD="sua_senha_crua"

AUTH_SECRET="substitua_por_um_segredo_longo_aleatorio"
AUTH_URL="http://localhost:3000"
