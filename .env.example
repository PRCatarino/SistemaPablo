# -----------------------------------------------------------------------------
# VERCEL — variáveis mínimas (Settings → Environment Variables)
#   DATABASE_URL     = Supabase → Transaction pooler :6543 + ?pgbouncer=true
#   AUTH_SECRET      = segredo forte (openssl rand -base64 32)
#   AUTH_URL         = https://seu-projeto.vercel.app  (ou apague e use o fallback no código)
#   NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
# Migrações NÃO rodam no build da Vercel. Depois do 1º deploy, no teu PC:
#   DATABASE_URL="postgresql://postgres:SENHA@db.<ref>.supabase.co:5432/postgres?sslmode=require" npx prisma migrate deploy
# -----------------------------------------------------------------------------
# Supabase — ProjetoPablo (ref: zqfojiivzffertqoaqsz)
# Dashboard: https://supabase.com/dashboard/project/zqfojiivzffertqoaqsz
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL="https://zqfojiivzffertqoaqsz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole_a_chave_aqui"

# Local / migrate: conexão direta :5432. Vercel runtime: pooler :6543 (ver texto acima).
DATABASE_URL="postgresql://postgres:SENHA_DO_BANCO@db.zqfojiivzffertqoaqsz.supabase.co:5432/postgres?sslmode=require"

# Exemplo pooler só para a Vercel (ajusta host na connection string do painel):
# DATABASE_URL="postgresql://postgres.zqfojiivzffertqoaqsz:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------

AUTH_SECRET="substitua_por_um_segredo_longo_aleatorio"
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Modo demonstração (sem Postgres — só localStorage). Desligue com Supabase.
