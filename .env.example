# -----------------------------------------------------------------------------
# ⚠️ VERCEL (Production): NÃO use DATABASE_URL com 127.0.0.1 ou host "db" do Docker.
# Copie do Supabase → Settings → Database:
#   DATABASE_URL = pooling Transaction (porta 6543) + ?pgbouncer=true
#   DIRECT_URL   = conexão direta db.<ref>.supabase.co:5432 + ?sslmode=require
# Obrigatório na Vercel: DATABASE_URL, DIRECT_URL, AUTH_SECRET (segredo forte),
# AUTH_URL (https://seu-app.vercel.app), NEXT_PUBLIC_SUPABASE_*.
# Opcional: POSTGRES_PASSWORD e SUPABASE_SECRET_KEY o app Next não lê — só Docker/futuro.
# -----------------------------------------------------------------------------
# Supabase — ProjetoPablo (ref: zqfojiivzffertqoaqsz)
# Dashboard: https://supabase.com/dashboard/project/zqfojiivzffertqoaqsz
# -----------------------------------------------------------------------------

# URL do projeto (API)
NEXT_PUBLIC_SUPABASE_URL="https://zqfojiivzffertqoaqsz.supabase.co"

# Chave anon / publishable (Settings → API → anon public / Publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole_a_chave_aqui"

# Postgres para Prisma — substitua SENHA_DO_BANCO (Settings → Database → Database password)
# Use ?sslmode=require
# Em dev local (sem pooler): DATABASE_URL e DIRECT_URL podem ser iguais (ambos na porta 5432).
DATABASE_URL="postgresql://postgres:SENHA_DO_BANCO@db.zqfojiivzffertqoaqsz.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:SENHA_DO_BANCO@db.zqfojiivzffertqoaqsz.supabase.co:5432/postgres?sslmode=require"

# Na Vercel (recomendado):
# - DATABASE_URL = Connection pooling → Transaction mode (porta 6543), com ?pgbouncer=true
# - DIRECT_URL   = conexão direta Session mode ou host db.*.supabase.co:5432 (só para migrate no build)
# Exemplo pooler (ajuste host conforme Settings → Database → Connection string):
# DATABASE_URL="postgresql://postgres.zqfojiivzffertqoaqsz:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.zqfojiivzffertqoaqsz.supabase.co:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------

# Gere com: openssl rand -base64 32
AUTH_SECRET="substitua_por_um_segredo_longo_aleatorio"

# URL pública do app. Local: localhost. Vercel: https://seu-projeto.vercel.app
# Se na Vercel estiver localhost, o app redireciona mal — corrija ou deixe em branco (usa VERCEL_URL).
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Modo demonstração (sem Postgres — só localStorage). Desligue com Supabase.
# NEXT_PUBLIC_KANBAN_DEMO=true
# -----------------------------------------------------------------------------

# Opcional: pasta de uploads em disco (fora da Vercel use Blob/Storage depois)
# UPLOAD_DIR=/caminho/absoluto/uploads

# Só na Vercel, se migrate deploy no build falhar e precisar publicar o site antes:
# SKIP_PRISMA_MIGRATE=1
# Depois rode no seu PC: npx prisma migrate deploy (com DIRECT_URL apontando ao Supabase)
