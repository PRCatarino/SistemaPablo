# -----------------------------------------------------------------------------
# VERCEL — Settings → Environment Variables (Production + Preview)
#
# DATABASE_URL (obrigatório em produção)
#   Supabase → Project Settings → Database → Connection string → URI
#   Escolha "Transaction pool" (PgBouncer, porta 6543), NÃO "Direct" nem localhost.
#   Formato típico (ajuste região e password):
#   postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1
#   Se a senha tiver @ # % etc., use URL encoding (ex. @ → %40).
#
# AUTH_SECRET, AUTH_URL (ou omitir AUTH_URL), NEXT_PUBLIC_SUPABASE_*
#
# Migrações: no PC, com conexão direta :5432:
#   $env:DATABASE_URL="postgresql://postgres:SENHA@db.SEU_REF.supabase.co:5432/postgres?sslmode=require"; npx prisma migrate deploy
# -----------------------------------------------------------------------------
# Supabase — ProjetoPablo (ref: zqfojiivzffertqoaqsz)
# Dashboard: https://supabase.com/dashboard/project/zqfojiivzffertqoaqsz
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL="https://zqfojiivzffertqoaqsz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole_a_chave_aqui"

# Local dev / migrate (direto :5432)
DATABASE_URL="postgresql://postgres:SENHA_DO_BANCO@db.zqfojiivzffertqoaqsz.supabase.co:5432/postgres?sslmode=require"

# Só Vercel — copiar do painel "Transaction pool":
# DATABASE_URL="postgresql://postgres.zqfojiivzffertqoaqsz:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1"

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------

AUTH_SECRET="substitua_por_um_segredo_longo_aleatorio"
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Modo demonstração (sem Postgres — só localStorage). Desligue com Supabase.
# NEXT_PUBLIC_KANBAN_DEMO=true
# -----------------------------------------------------------------------------

# Opcional: pasta de uploads (VPS/Docker). Na Vercel usa /tmp automaticamente.
# UPLOAD_DIR=/caminho/absoluto/uploads
