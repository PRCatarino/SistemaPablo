# -----------------------------------------------------------------------------
# Postgres — mesmo padrão mental que salaoBeleza (VPS sem TLS: DATABASE_SSL=false).
#
# Local com banco de TESTE na VPS: define só DATABASE_URL_TEST (a app e db:*:test usam isto).
# Produção (Vercel): define só DATABASE_URL (não uses DATABASE_URL_TEST lá).
#
# Migrations contra o DB de teste: npm run db:deploy:test
# Migrations contra o URL em DATABASE_URL (ex.: prod): npm run db:deploy
# -----------------------------------------------------------------------------

# Banco de teste (prioridade na app quando definido)
DATABASE_URL_TEST="postgresql://salao_app:SENHA@31.56.44.101:5432/seu_app_teste"

# Produção / fallback quando DATABASE_URL_TEST não existe
# DATABASE_URL="postgresql://salao_app:SENHA@31.56.44.101:5432/seu_app"

# VPS sem SSL na porta 5432 (como salaoBeleza)
DATABASE_SSL=false

# Opcional: senha separada (encoding automático na URI — ver src/lib/database-url.ts)
# POSTGRES_PASSWORD="sua_senha_crua"

AUTH_SECRET="substitua_por_um_segredo_longo_aleatorio"
AUTH_URL="http://localhost:3000"
