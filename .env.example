# -----------------------------------------------------------------------------
# DATABASE_URL — Supabase (pooler 6543 na Vercel / dev recomendado).
#   postgresql://postgres.SEU_REF:SENHA_ENCODED@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1
#
# Senha com caracteres especiais: codifica na URL (%XX) ou POSTGRES_PASSWORD + URI com placeholder
# (ver src/lib/database-url.ts). O Prisma CLI (migrate deploy) lê DATABASE_URL tal como está no .env.
#
# Se migrate deploy falhar ou travar na tua rede: cola supabase/apply-migrations-once.sql no
# SQL Editor do Supabase (resolve schema + _prisma_migrations). Ou GitHub Actions
# (.github/workflows/prisma-migrate.yml) com secret DATABASE_URL (direto :5432 costuma funcionar).
#
# Storage: supabase/storage-card-attachments.sql
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL="https://SEU_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole_a_chave_aqui"

SUPABASE_SERVICE_ROLE_KEY="cole_service_role_ou_sb_secret_aqui"

DATABASE_URL="postgresql://postgres.SEU_REF:SENHA_ENCODED@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# POSTGRES_PASSWORD="sua_senha_crua"

AUTH_SECRET="substitua_por_um_segredo_longo_aleatorio"
AUTH_URL="http://localhost:3000"
