# -----------------------------------------------------------------------------
# Supabase — ProjetoPablo (ref: zqfojiivzffertqoaqsz)
# Dashboard: https://supabase.com/dashboard/project/zqfojiivzffertqoaqsz
# -----------------------------------------------------------------------------

# URL do projeto (API)
NEXT_PUBLIC_SUPABASE_URL="https://zqfojiivzffertqoaqsz.supabase.co"

# Chave anon / publishable (Settings → API → anon public / Publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole_a_chave_aqui"

# Postgres para Prisma — substitua SENHA_DO_BANCO (Settings → Database → Database password)
# Use ?sslmode=require
DATABASE_URL="postgresql://postgres:SENHA_DO_BANCO@db.zqfojiivzffertqoaqsz.supabase.co:5432/postgres?sslmode=require"

# Na Vercel com Connection Pooler (recomendado): use a URI "Transaction" no dashboard como DATABASE_URL
# e mantenha uma URI direta :5432 só para rodar migrações no seu PC (ou em CI).
# Exemplo pooler (ajuste região/host conforme o painel):
# DATABASE_URL="postgresql://postgres.zqfojiivzffertqoaqsz:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------

# Gere com: openssl rand -base64 32
AUTH_SECRET="substitua_por_um_segredo_longo_aleatorio"

# URL pública do app (Vercel: https://seu-projeto.vercel.app)
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Modo demonstração (sem Postgres — só localStorage). Desligue com Supabase.
# NEXT_PUBLIC_KANBAN_DEMO=true
# -----------------------------------------------------------------------------

# Opcional: pasta de uploads em disco (fora da Vercel use Blob/Storage depois)
# UPLOAD_DIR=/caminho/absoluto/uploads
