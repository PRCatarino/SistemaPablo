# -----------------------------------------------------------------------------
# VERCEL — Settings → Environment Variables (Production + Preview)
#
# DATABASE_URL (obrigatório)
#   Supabase → Project Settings → Database → Connection string → URI
#   Use "Transaction pool" (PgBouncer, porta 6543), não "Direct" em serverless.
#   Exemplo:
#   postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1
#   Senha com @ # etc.: defina POSTGRES_PASSWORD (crua) — a app codifica na URI.
#
# Anexos dos cards: Storage Supabase (bucket card-attachments). Rode no SQL Editor:
#   supabase/storage-card-attachments.sql
#
# Migrações no PC (conexão direta :5432):
#   $env:DATABASE_URL="postgresql://postgres:SENHA@db.SEU_REF.supabase.co:5432/postgres?sslmode=require"; npx prisma migrate deploy
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL="https://SEU_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole_a_chave_anon_aqui"

# Servidor (upload de anexos no bucket). Painel → Settings → API → service_role (nunca no cliente).
SUPABASE_SERVICE_ROLE_KEY="cole_service_role_aqui"

# Dev (npm run dev): use o MESMO Postgres do Supabase (URI direta :5432), não localhost —
# senão o app fala com um banco vazio e aparece "Esquema do banco desatualizado".
DATABASE_URL="postgresql://postgres:SENHA@db.SEU_REF.supabase.co:5432/postgres?sslmode=require"

# Opcional na Vercel se a senha tiver caracteres especiais na URL
# POSTGRES_PASSWORD="sua_senha_crua"

# Na Vercel (pooler):
# DATABASE_URL="postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1"

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------

AUTH_SECRET="substitua_por_um_segredo_longo_aleatorio"
AUTH_URL="http://localhost:3000"
