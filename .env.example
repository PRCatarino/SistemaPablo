# PostgreSQL (ex.: Docker na VPS ou serviço gerenciado)
DATABASE_URL="postgresql://trelloroupa:senha_segura@localhost:5432/trelloroupa"

# Gere com: openssl rand -base64 32
AUTH_SECRET="substitua_por_um_segredo_longo_aleatorio"

# URL pública do app (obrigatório em produção atrás de domínio/HTTPS)
# Vercel: use o domínio do projeto, ex.: https://sistema-pablo.vercel.app
# Ex.: https://kanban.seudominio.com
AUTH_URL="http://localhost:3000"

# Demonstração na Vercel SEM Postgres: Kanban + anexos (pequenos) no localStorage.
# Remova ou defina como false quando tiver DATABASE_URL em produção.
# NEXT_PUBLIC_KANBAN_DEMO=true

# Opcional: NODE_ENV=production na VPS
#
# Primeira subida com Docker: após `docker compose up -d`, rode uma vez:
#   docker compose run --rm web npm run db:seed
#
# Pasta de uploads (imagens dos cards). No Docker já é /app/uploads (volume).
# UPLOAD_DIR=/caminho/absoluto/uploads
